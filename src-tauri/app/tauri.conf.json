{
  "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MVPTime",
  "version": "0.1.5",
  "identifier": "com.mvptime.desktop",
  "build": {
    "frontendDist": "../../apps/desktop/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev -w @mvptime/desktop",
    "beforeBuildCommand": "npm run build -w @mvptime/desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MVPTime",
        "width": 1100,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "devtools": true,
        "zoomHotkeysEnabled": false,
        "browserExtensionsEnabled": false,
        "allowLinkPreview": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYzMzcwRUE4NkU2MDMzMzAKUldRd00yQnVxQTQzODFvNDYyVU1sNEFPd0Voc0R5RXNqOEM5NXlLdDh5SStwNmc1NXVBamJZQ1kK",
      "endpoints": [
        "https://github.com/__UPDATER_GITHUB_REPO__/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

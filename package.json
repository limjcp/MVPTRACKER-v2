    "jspdf-autotable": "^3.8.4",
    "lucide-react": "^1.9.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router-dom": "^7.9.6",
    "recharts": "^3.8.1",
    "tailwind-merge": "3.4.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
